{
  "section": "Error: schema, codes and duplicates",
  "cases": [
    {
      "name": "unsupported resourceType",
      "resource": {
        "resourceType": "Patient"
      },
      "expect": {
        "error": "Unsupported resource type: Patient"
      }
    },
    {
      "name": "no schema",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "frequency": 1
            }
          }
        }
      ],
      "expect": {
        "error": "Die Dosierung entspricht keinem unterstützten Dosierungsschema."
      }
    },
    {
      "name": "timeOfDay together with when (tim-10)",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "when": [
                "MORN"
              ],
              "timeOfDay": [
                "08:00:00"
              ]
            }
          }
        }
      ],
      "expect": {
        "error": "timeOfDay und when dürfen nicht gemeinsam angegeben werden (tim-10)."
      }
    },
    {
      "name": "timing ohne repeat",
      "dosages": [
        {
          "timing": {
            "code": {
              "text": "BID"
            }
          },
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ]
        }
      ],
      "expect": {
        "error": "Die Dosierung entspricht keinem unterstützten Dosierungsschema."
      }
    },
    {
      "name": "mixed schemas",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "when": [
                "MORN"
              ]
            }
          }
        },
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 2,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "dayOfWeek": [
                "mon"
              ]
            }
          }
        }
      ],
      "expect": {
        "error": "Alle Dosage-Elemente müssen demselben Schema folgen; Element 1 ergibt '4-Schema', Element 2 'DayOfWeek'."
      }
    },
    {
      "name": "timeOfDay not zero-padded",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "timeOfDay": [
                "8:00"
              ]
            }
          }
        }
      ],
      "expect": {
        "error": "timeOfDay muss im Format HH:MM oder HH:MM:SS[.Bruchteile] angegeben sein."
      }
    },
    {
      "name": "minimum interval with unknown time unit",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "asNeededBoolean": true,
          "modifierExtension": [
            {
              "url": "http://ig.fhir.de/igs/medication/StructureDefinition/MinimumIntervalBetweenAdministrations",
              "valueDuration": {
                "value": 4,
                "code": "x"
              }
            }
          ]
        }
      ],
      "expect": {
        "error": "Nicht unterstützte Zeiteinheit: 'x'."
      }
    },
    {
      "name": "unknown when code",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "when": [
                "XYZ"
              ]
            }
          }
        }
      ],
      "expect": {
        "error": "Nicht unterstützter Tagesabschnitt (when): 'XYZ'."
      }
    },
