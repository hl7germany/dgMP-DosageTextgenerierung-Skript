{
  "section": "Time-of-day schema",
  "cases": [
    {
      "name": "time: 08:00 Uhr",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "timeOfDay": [
                "08:00:00"
              ]
            }
          }
        }
      ],
      "expect": {
        "text": "täglich: 08:00 Uhr — je 1 Stück"
      }
    },
    {
      "name": "time: example with two elements",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "timeOfDay": [
                "08:00:00",
                "12:00:00"
              ]
            }
          }
        },
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 2,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "timeOfDay": [
                "20:00:00"
              ]
            }
          }
        }
      ],
      "expect": {
        "text": "täglich: 08:00 Uhr, 12:00 Uhr — je 1 Stück, 20:00 Uhr — je 2 Stück"
      }
    },
