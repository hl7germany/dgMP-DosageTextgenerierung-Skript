{
  "section": "Interval combination",
  "cases": [
    {
      "name": "rhythm: combination wöchentlich",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "period": 1,
              "periodUnit": "wk",
              "when": [
                "MORN"
              ]
            }
          }
        }
      ],
      "expect": {
        "text": "wöchentlich: morgens — je 1 Stück"
      }
    },
