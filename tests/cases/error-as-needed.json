{
  "section": "Error: as needed, minimum interval and max dose",
  "cases": [
    {
      "name": "pure as needed, two elements",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "asNeededBoolean": true
        },
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 2,
                "unit": "Stück"
              }
            }
          ],
          "asNeededBoolean": true
        }
      ],
      "expect": {
        "error": "Reine Bedarfsmedikation erlaubt genau ein Dosage-Element."
      }
    },
    {
      "name": "max dose with rhythm",
      "dosages": [
        {
          "doseAndRate": [
            {
              "doseQuantity": {
                "value": 1,
                "unit": "Stück"
              }
            }
          ],
          "timing": {
            "repeat": {
              "frequency": 1,
              "period": 8,
              "periodUnit": "h"
            }
          },
          "asNeededBoolean": true,
          "maxDosePerPeriod": {
            "numerator": {
              "value": 4,
              "unit": "Stück"
            },
            "denominator": {
              "value": 1,
              "code": "d"
            }
          }
        }
      ],
      "expect": {
        "error": "Eine Maximalmenge ist nur bei reiner Bedarfsmedikation zulässig, nicht zusammen mit einem strukturierten Rhythmus."
      }
    },
    {
      "name": "minimum interval with rhythm",
